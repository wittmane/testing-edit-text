<!-- (EW) I used tab_indicator_material as a starting point to match the default TabWidget except on
     attributes I specifically created this to deviate from, particularly removing unnecessary
     whitespace from forcing tabs to be the same width, allowing long text to ellipsize, centering
     text that wraps (since we're not showing an icon), and reducing the min width. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="?android:attr/actionBarSize"
    android:layout_weight="0"
    android:orientation="horizontal"
    android:minWidth="60dp"
    style="?attr/tabStyle">

    <TextView
        android:id="@android:id/title"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="center_vertical"
        android:gravity="center"
        android:ellipsize="end"
        android:height="@null"
        android:textAllCaps="false"
        style="?attr/tabTextStyle" />

</LinearLayout>
